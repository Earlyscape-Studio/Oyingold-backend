// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../generated/prisma"
}

// Node-runtime client used only by local scripts (prisma/seed-orders.ts).
// The main client above targets Cloudflare Workers and cannot run under plain Node.
generator nodeClient {
  provider = "prisma-client"
  runtime  = "nodejs"
  output   = "../generated/prisma-node"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum PaymentMethod {
  CARD
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CheckoutMode {
  INLINE
  STANDARD
}

enum OrderStatus {
  PENDING_PAYMENT
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  supabaseId String  @unique // maps to Supabase auth user id
  email     String   @unique
  role      Role     @default(CUSTOMER)
  fullName  String?
  phone     String?
  createdAt DateTime @default(now())

  orders    Order[]
  cart      Cart?
  addresses Address[]
  wishlist  WishlistItem[]
}

model Address {
  id         String    @id @default(uuid())
  userId     String
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  country    String    @default("Nigeria")
  isDefault  Boolean   @default(false)
  lastUsedAt DateTime? // set whenever checkout uses this address
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  brandId     String
  images      String[] @default([])
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category        @relation(fields: [categoryId], references: [id])
  brand       Brand           @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
}

model WishlistItem {
  id        String  @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  sku            String   @unique
  unitLabel      String   // e.g. "1 Litre", "5kg", "700ml"
  unitsPerCarton Int
  cartonPrice    Decimal  @db.Decimal(12, 2)
  piecePrice     Decimal? @db.Decimal(12, 2) // nullable — some SKUs are carton-only
  stockLevel     Int      @default(0)
  lowStockThreshold Int   @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product     @relation(fields: [productId], references: [id])
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([productId])
}

model Order {
  id         String      @id @default(uuid())
  orderNumber Int        @unique @default(autoincrement()) // shown to customers as OG-000123
  userId     String
  status     OrderStatus @default(PENDING_PAYMENT)

  // Money. totalAmount = subtotal + shippingFee + paymentFee - discount.
  // All of these are computed server-side; the client never sends them.
  subtotal    Decimal    @default(0) @db.Decimal(12, 2)
  shippingFee Decimal    @default(0) @db.Decimal(12, 2)
  paymentFee  Decimal    @default(0) @db.Decimal(12, 2) // gateway fee passed to the customer; always 0 for COD
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount Decimal    @db.Decimal(12, 2)

  paymentMethod PaymentMethod @default(CARD)

  // Contact details captured at checkout (nullable so pre-checkout orders stay valid).
  contactEmail String?
  contactPhone String?
  companyName  String?
  notes        String?

  trackingNumber String?

  // Snapshot of the delivery address at checkout:
  // { fullName, phone, street, city, state, country, zipCode? }
  shippingAddress Json?

  // Set when a paid order can't be fulfilled as-is (e.g. stock ran out between
  // order creation and payment confirmation). Surfaced to admins for follow-up.
  needsAttention       Boolean @default(false)
  needsAttentionReason String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payments   Payment[]

  @@index([userId])
  @@index([needsAttention])
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productVariantId String
  pricingType      String  // "carton" | "piece" — locks in which price was used
  unitPrice        Decimal @db.Decimal(12, 2) // snapshot at time of order
  quantity         Int

  order            Order          @relation(fields: [orderId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id               String   @id @default(uuid())
  cartId           String
  productVariantId String
  pricingType      String   // "carton" | "piece" — same convention as OrderItem.pricingType
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId, pricingType])
  @@index([cartId])
}

// One row per payment attempt. An order can have several (e.g. a failed card
// attempt followed by a retry). COD orders have no Payment row.
model Payment {
  id               String        @id @default(uuid())
  orderId          String
  reference        String        @unique // our reference, sent to FCMB as tranref / paymentReference
  gatewayReference String?       // FCMB's reference, known once the gateway responds
  checkoutMode     CheckoutMode
  amount           Decimal       @db.Decimal(12, 2) // what we asked the customer to pay
  fee              Decimal?      @db.Decimal(12, 2) // fee reported by the gateway
  status           PaymentStatus @default(PENDING)
  gatewayCode      String?       // e.g. "00", "S12", "SM_51"
  gatewayMessage   String?
  channel          String?       // e.g. "card"
  rawResponse      Json?         // last verify (status query) response
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

// Every webhook notification item is stored before any processing, as FCMB's docs advise.
// eventId is unique, so retried notifications are not processed twice.
model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  reference   String?   // transaction reference from the payload, if present
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([reference])
}
